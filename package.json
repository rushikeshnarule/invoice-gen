{
  "name": "invoice-gen",
  "private": true,
  "version": "1.3.1",
  "description": "Commercial Invoice & Billing Workstation",
  "author": "Invoice Gen",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package:installer": "electron-builder --win nsis",
    "package:portable": "electron-builder --win portable",
    "package:exe": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:dmg": "npm run build && electron-builder --mac dmg",
    "package:mac:zip": "npm run build && electron-builder --mac zip",
    "package:all": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "com.invoicegen.desktop",
    "productName": "Invoice Gen",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "asar": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoice Gen",
      "uninstallDisplayName": "Invoice Gen",
      "artifactName": "Invoice-Gen-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "mac": {
      "icon": "public/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Invoice Gen",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "Invoice-Gen-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@types/qrcode": "^1.5.6",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
