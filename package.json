{
  "name": "invoice-gen",
  "private": true,
  "version": "1.4.2.1",
  "description": "Commercial Invoice & Billing Workstation",
  "author": "Invoice Gen",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/patch-builder.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package:installer": "electron-builder --win nsis",
    "package:portable": "electron-builder --win portable",
    "build:unlocked": "tsc -b && vite build --mode unlocked",
    "package:unlocked:exe": "npm run build:unlocked && electron-builder --win nsis",
    "package:unlocked:portable": "npm run build:unlocked && electron-builder --win portable",
    "build:us": "tsc -b && vite build --mode us",
    "package:us:exe": "npm run build:us && electron-builder --win nsis -c.nsis.artifactName=\"Invoice-Gen-US-Setup-${version}.${ext}\" -c.productName=\"Invoice Gen US Edition\" -c.win.icon=\"public/icon-us.ico\"",
    "package:us:portable": "npm run build:us && electron-builder --win portable -c.productName=\"Invoice Gen US Edition\" -c.win.icon=\"public/icon-us.ico\"",
    "package:exe": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac pkg",
    "package:mac:pkg": "npm run build && electron-builder --mac pkg",
    "package:mac:dmg": "npm run build && electron-builder --mac dmg",
    "package:update": "node scripts/pack-asar.cjs",
    "package:mac:offline": "node scripts/pack-asar.cjs && python scripts/build-mac.py",
    "package:android": "npm run build && npx cap sync android",
    "package:all": "npm run build && electron-builder -mw",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.invoicegen.desktop",
    "productName": "Invoice Gen",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "inv",
        "name": "Invoice Gen Document",
        "description": "Invoice Gen Commercial Invoice Document",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "invoice",
        "name": "Invoice Gen Document",
        "description": "Invoice Gen Commercial Invoice Document",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "build/**/*"
    ],
    "asar": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoice Gen",
      "uninstallDisplayName": "Invoice Gen",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "artifactName": "Invoice-Gen-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "public/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "pkg": {
      "hasStrictIdentifier": true,
      "installLocation": "/Applications",
      "artifactName": "Invoice-Gen-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Invoice Gen",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "Invoice-Gen-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/react": "^4.0.90",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@internationalized/date": "^3.12.1",
    "@netlify/functions": "^6.1.1",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "ai": "^7.0.87",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
